# Copy to /etc/raisanngam-line-bot/line-bot.env as root:raisanngam-line-bot
# with mode 0640 so the dedicated service account can read it. Never commit its values.
LINE_BOT_CHANNEL_SECRET=
LINE_BOT_CHANNEL_ACCESS_TOKEN=
LINE_BOT_ALLOWED_GROUP_IDS=
# Groups in this subset use the automatic two-photo Vision Product flow.
# Leave blank to retain the legacy Quote + \"บอท\" workflow for every allowed group.
LINE_BOT_VISION_PRODUCT_GROUP_IDS=
# Enable only while discovering the first group ID. It records signed events
# without processing them; switch it off after populating the allowlist.
LINE_BOT_ENROLLMENT_MODE=0
LINE_BOT_USER_ID=
POS_LINE_BOT_BASE_URL=https://posbot.raisanngam.com
# Generate a 32-byte-or-longer random secret. Its value must equal the Production POS setting.
POS_LINE_BOT_SHARED_SECRET=
LINE_BOT_DATA_ROOT=/var/lib/raisanngam-line-bot
LINE_BOT_PORT=8010
LINE_BOT_RETRY_SECONDS=300
# Required only when LINE_BOT_VISION_PRODUCT_GROUP_IDS is non-empty.
GEMINI_API_KEY=
# Use only a model verified by the enabled Gemini billing project. As of this
# template update, `gemini-3.1-flash-lite` is the supported structured-Vision
# choice; `gemini-3.1-flash` is not an interchangeable model ID.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=25
# Exactly one provider attempt per product. This prevents an automatic retry
# from consuming another product's budget; manual entry remains the fallback.
GEMINI_MAX_ATTEMPTS=1
# Hard application-level monthly cap. The bot reserves a conservative maximum
# before each call; it never invokes Gemini when this cap would be exceeded.
GEMINI_MONTHLY_BUDGET_USD=1.00
# These are USD per 1M tokens for the selected model. Verify and update both
# values whenever GEMINI_MODEL changes; the defaults match 3.1 Flash-Lite.
GEMINI_INPUT_USD_PER_MILLION_TOKENS=0.25
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=1.50
